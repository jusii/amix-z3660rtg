# The .moddata keys of the module form (amix-dlm C3-1 section 3, C3-6 section 3), one
# key=value string per line as the section carries them.  The line's kabi and cc come from
# the ABI kit, cpu too (the line's); module/Makefile turns this file into the kit's Master.
name=z3660rtg
class=demand
majors=c:49
depend=monsw
unload=allowed
desc=Z3660/ZZ9000 RTG framebuffer
param=blit:bool:1
param=maxarea:int:0:0:3686400
